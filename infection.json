{
    "$schema": "vendor/infection/infection/resources/schema.json",
    "timeout": 2,
    "source": {
        "directories": [
            "src"
        ]
    },
    "staticAnalysisTool": "phpstan",
    "staticAnalysisToolOptions": "--memory-limit=256M",
    "logs": {
        "text": "infection-log.txt"
    },
    "minMsi": 100,
    "minCoveredMsi": 100,
    "mutators": {
        "global-ignoreSourceCodeByRegex": [
            "assert\\(.+\\);"
        ],
        "@default": true,
        "DecrementInteger": {
            "ignoreSourceCodeByRegex": [
                "\\$highest = PHP_INT_MAX - max\\(\\$right, 0\\);",
                "\\$lowest = PHP_INT_MIN \\+ max\\(\\$right, 0\\);"
            ]
        },
        "IncrementInteger": {
            "ignoreSourceCodeByRegex": [
                "\\$lowest = PHP_INT_MIN - min\\(\\$right, 0\\);",
                "\\$highest = PHP_INT_MAX \\+ min\\(\\$right, 0\\);"
            ]
        }
    }
}
